# Configuración del panel de administrador (#/admin) que SÍ se sube a GitHub.
# Acá va solo lo que no es secreto. Lo privado (tu mail, la clave de Gmail) va en .env.local,
# que no se sube y pisa lo que haya acá. Después de cambiar algo, reiniciá `npm run dev`.

# Cuenta de prueba para que cualquiera que clone el proyecto pueda entrar al panel.
# Funciona solo mientras no haya ninguna cuenta creada por mail. El panel solo responde
# desde la misma compu donde corre `npm run dev`, así que esta clave no abre nada desde afuera.
ADMIN_USER=Conejo
ADMIN_PASSWORD=conejo

# Mails que pueden crear cuenta (separados por coma). Ponelos en .env.local, no acá:
# ADMIN_EMAILS=tu-mail@gmail.com

# Gmail para mandar los códigos: SIEMPRE en .env.local, nunca acá.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
